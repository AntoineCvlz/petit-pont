NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clé « Publishable » affichée par `supabase status`
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Tests d'intégration locaux uniquement : clé « Secret » de `supabase status`
